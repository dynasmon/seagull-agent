SEAGULL_AGENT_ID=
SEAGULL_API_URL=
SEAGULL_ENROLL_URL=
SEAGULL_AGENT_PROFILE=sensor
SEAGULL_SOURCES=authlog,proc,proc_exec,fim,scan,ddos,l7,syscollector,vuln

SEAGULL_AGENT_CONFIG_FILE=/var/lib/seagull/agent.config.json
SEAGULL_AGENT_IDENTITY_STATE_FILE=/var/lib/seagull/agent.identity.json
SEAGULL_AGENT_CREDENTIAL_FILE=/var/lib/seagull/agent.credential
SEAGULL_AGENT_BOOTSTRAP_TOKEN_FILE=/var/lib/seagull/bootstrap.token

SEAGULL_AGENT_SPOOL_DIR=/var/lib/seagull/spool
SEAGULL_AGENT_SPOOL_MAX_BYTES=268435456
SEAGULL_AGENT_SPOOL_MAX_AGE=24h
SEAGULL_AGENT_SPOOL_MAX_ITEMS=10000
SEAGULL_AUTHLOG_CHECKPOINT_FILE=/var/lib/seagull/checkpoints/authlog.json

SEAGULL_RESPONSE_ACTION_JOURNAL_DIR=/var/lib/seagull/response-actions
SEAGULL_RESPONSE_ACTION_JOURNAL_MAX_ITEMS=2048
SEAGULL_RESPONSE_ACTION_JOURNAL_MAX_BYTES=67108864
SEAGULL_RESPONSE_QUARANTINE_DIR=/var/lib/seagull/quarantine
SEAGULL_RESPONSE_ALLOW_SHELL_EXEC=false
SEAGULL_RESPONSE_SHELL_EXEC_ALLOWLIST=

SEAGULL_TLS_CA_FILE=
SEAGULL_TLS_CERT_FILE=/var/lib/seagull/pki/client.crt
SEAGULL_TLS_KEY_FILE=/var/lib/seagull/pki/client.key
SEAGULL_TLS_SERVER_NAME=

SEAGULL_LOG_LEVEL=info
