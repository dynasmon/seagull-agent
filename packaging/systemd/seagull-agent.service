[Unit]
Description=Seagull Agent
Documentation=https://github.com/dynasmon/seagull-agent
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=seagull
Group=seagull

EnvironmentFile=/etc/seagull/agent.env
ExecStart=/usr/local/bin/seagull-agent

Restart=always
RestartSec=5
TimeoutStopSec=20
UMask=0077

StateDirectory=seagull
LogsDirectory=seagull
RuntimeDirectory=seagull

NoNewPrivileges=true
AmbientCapabilities=
CapabilityBoundingSet=
LimitNOFILE=65536

PrivateTmp=true
PrivateDevices=true
ProtectHome=true
ProtectSystem=strict
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictSUIDSGID=true
RestrictNamespaces=true
RestrictRealtime=true
LockPersonality=true
MemoryDenyWriteExecute=true
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK AF_PACKET

ReadWritePaths=/var/lib/seagull /var/log/seagull /run/seagull
ReadOnlyPaths=/etc/seagull
ReadOnlyPaths=-/var/log/auth.log
ReadOnlyPaths=-/var/log/secure

[Install]
WantedBy=multi-user.target
